# Use fixture for offline MCP or neo4j for the live graph backend.
GRAPH_BACKEND=fixture
GRAPH_FIXTURE_PATH=fixtures/synthetic_graph.json
GRAPH_FIXTURE_ID=synthetic-java-test-framework-v1
GRAPH_FIXTURE_VERSION=v1.0.0

# Required only when GRAPH_BACKEND=neo4j.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_local_secret
