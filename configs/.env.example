# Neo4j Connection Configuration

# Local Neo4j Desktop
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Remote Neo4j Server (Optional)
NEO4J_URI_REMOTE=bolt://your-server.com:7687
NEO4J_USER_REMOTE=admin
NEO4J_PASSWORD_REMOTE=remote_password_here

# OpenAI API (Optional - for semantic analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Project Paths
WORKSPACE_ROOT=/path/to/your/workspace
GENERIC_DOCS_PATH=/path/to/documentation

# Ingestion Settings
USE_LOCAL=true
BATCH_SIZE=50
ENABLE_SEMANTIC_ANALYSIS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=ingestion.log
